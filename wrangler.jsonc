{
  // Static site (Cloudflare Workers Static Assets) with a small Worker in
  // front of it, which serves /assets/*.jpg out of the R2 bucket. See worker.js.
  //
  // The site lives in ./public rather than the repo root. That is deliberate:
  // with "directory": "." the deploy published everything not explicitly
  // ignored, including .git — and a fresh clone packs its objects into a single
  // file well over the 25 MiB per-asset limit, which fails the build. A
  // dedicated directory means only what belongs on the web can ever be served.
  // Must match the Workers Builds project name, which is haris-carpetsv5. With
  // "haris-carpets" here the CI overrode it on every build, and a local
  // `wrangler deploy` would have gone to a different Worker entirely.
  "name": "haris-carpetsv5",
  "main": "worker.js",
  "compatibility_date": "2026-08-06",

  "assets": {
    "directory": "./public",
    // lets the Worker hand anything it doesn't handle back to static assets
    "binding": "ASSETS",
    // static assets are normally served before the Worker ever runs, which
    // would mean the bundled photos always win over R2. This flips the order
    // so the Worker gets first look; it passes everything else straight on.
    "run_worker_first": true
  },

  // Two schedules, told apart in worker.js by event.cron.
  //
  // Weekly: refreshes the Instagram token and the cached feed. Weekly because a
  // long-lived token lasts 60 days — five missed runs before anything breaks.
  //
  // Half-hourly: deletes enquiries once they are past twelve months. That
  // number is a promise made on public/privacy.html — move one and you must
  // move the other, or the privacy notice stops being true.
  "triggers": {
    "crons": ["0 4 * * 1", "*/30 * * * *"]
  },

  // Enquiry flood protection. A Worker binding rather than a WAF rule on
  // purpose: WAF rate-limiting is zone-scoped and the site is on workers.dev,
  // the same wall that stopped Cloudflare Access guarding /admin. The counter
  // is per Cloudflare location and reconciled after the fact, so treat these as
  // a ceiling rather than an exact allowance. Changing namespace_id resets the
  // counters.
  "ratelimits": [
    { "name": "ENQUIRY_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "ENQUIRY_BUDGET", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],

  // Enquiry notifications, once haris-carpets.co.uk is a zone in this account.
  // Uncomment, put the verified destination address in, and redeploy: the
  // Worker then emails the shop a copy of every enquiry itself, with no third
  // party and nothing new to name in the privacy policy.
  //
  // "destination_address" must already be verified under that zone's Email
  // Routing — Cloudflare will only send to an address that has confirmed it.
  // That restriction is the whole reason this is safe to switch on.
  //
  // "send_email": [
  //   { "name": "SEND_EMAIL", "destination_address": "sales@hariscarpets.co.uk" }
  // ],

  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "haris-carpets"
    }
  ],

  // Who is allowed into /admin. Both come from the Cloudflare Access
  // application that sits in front of it — see docs/admin.md for where to find
  // them. They are identifiers, not secrets: the team domain is public and the
  // AUD tag only names the application. What actually keeps people out is the
  // signature check in worker-admin.js, which verifies every token against
  // Cloudflare's own public keys.
  //
  // Leave these empty and the admin API answers 503 with an explanation. That
  // is deliberate — an unconfigured admin must refuse everyone, never admit
  // everyone.
  //
  // Where a notification goes, and who it comes from.
  //
  // ENQUIRY_TO is the shop's mailbox. ENQUIRY_FROM_ADDRESS is used by the
  // Cloudflare sender; leave it empty and it sends from enquiries@ at the same
  // domain as ENQUIRY_TO, which is what you want once that domain is the zone.
  //
  // ENQUIRY_FROM is only for the Resend fallback, and stays on resend.dev
  // until the domain moves: claiming a domain whose SPF and DKIM live at Wix,
  // in mail sent to that same domain, is the self-spoof pattern and gets the
  // mail junked. See worker-enquiry.js.
  // Visitor numbers, read in the admin's Visitors tab. Neither of these is a
  // credential: the account id is in the dashboard URL and the site tag is in
  // the page source of every page. The API token that goes with them IS a
  // secret and is set with `wrangler secret put CF_ANALYTICS_TOKEN`.
  //
  // Empty means the tab says which of the three is still to be set, rather
  // than showing an empty page. See worker-analytics.js.
  "vars": {
    "CF_ACCOUNT_ID": "",
    "CF_SITE_TAG": "",
    "ACCESS_TEAM_DOMAIN": "hariscarpets.cloudflareaccess.com",
    "ACCESS_AUD": "e92c87786ba2f3b9ea09d089a1ec2a73df59c19052763d46d6730b06b32ffc2c",
    "ENQUIRY_TO": "sales@hariscarpets.co.uk",
    "ENQUIRY_FROM_ADDRESS": "",
    "ENQUIRY_FROM": "Hari's Carpets <onboarding@resend.dev>"
  }
}
